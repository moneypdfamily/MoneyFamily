# LINE Bot Credentials (จาก LINE Developers Console -> Messaging API)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Google Gemini (AI Studio) — ใช้ก่อน OpenAI ถ้าตั้งค่าไว้
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (ทางเลือกสำรอง)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Credentials (จาก Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# LINE LIFF ID (จาก LINE Developers Console -> LIFF)
# ต้องตรงกับ "LIFF ID" ของแอปที่สร้างไว้ และ Endpoint URL ต้องเป็นโดเมนเดียวกับ NEXT_PUBLIC_APP_URL
# ตัวอย่าง: 2012284598-NotCayv0
NEXT_PUBLIC_LIFF_ID=your_liff_id_here

# Vercel Cron Secret (สำหรับป้องกัน Cron Endpoint)
CRON_SECRET=your_random_secret_token_here

# App URL (สำหรับสร้างลิงก์และ QR Code)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

